<?xml version="1.0" encoding="utf-8"?>
<!-- Carnet de rêves — manifeste Android. Version : versionCode (entier, +1 à chaque mise à jour) et versionName. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="fr.brasselet.carnetreves"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Android 10 minimum ; conçu pour Android 15 (cible actuelle). -->
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />

    <!-- Par sécurité pour le moteur WebView : l'appli ne se connecte à aucun serveur,
         la page est servie depuis le téléphone et les rêves y restent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pré-remplir le réveil du téléphone (l'utilisateur valide dans l'appli Horloge). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <application
        android:label="Carnet de rêves"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
